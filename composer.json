{
    "name": "akaunting/laravel-sortable",
    "description": "Sortable behavior package for Laravel",
    "keywords": [
        "laravel",
        "sort",
        "sortable",
        "sorting",
        "model",
        "view",
        "blade",
        "column"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Duliçi",
            "email": "info@akaunting.com",
            "homepage": "https://akaunting.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^8.0|^9.1.4|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Akaunting\\Sortable\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akaunting\\Sortable\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akaunting\\Sortable\\Provider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
